# Copy to .env.local and fill in.

# Public URL of the deployed site; used for canonical URLs, Open Graph tags, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form delivery via Web3Forms (https://web3forms.com).
# 1. Go to https://web3forms.com and enter your email (achirasandaruwan123@gmail.com)
# 2. You'll receive an access key in your inbox — paste it below.
# Client-side form submission uses NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
WEB3FORMS_ACCESS_KEY=
